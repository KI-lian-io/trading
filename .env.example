# Copy to .env on your server (never commit .env). Freqtrade reads these and they override config.json.
# Binance key: enable "Spot trading" only, keep withdrawals OFF, restrict to your server's IP.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
# FreqUI / REST API login (used by user_data/config_dryrun.json). Generate random values, e.g. `openssl rand -hex 32`.
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=
